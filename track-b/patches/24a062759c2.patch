From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nihad Uddin <nihad.uddin@tum.de>
Date: Sun, 15 Nov 2026 16:51:08 +0100
Subject: [PATCH] Log the duration of calculateAllResults for the Track B
 benchmark (decision D17)

---
 .../cit/aet/artemis/quiz/service/QuizSubmissionService.java   | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/main/java/de/tum/cit/aet/artemis/quiz/service/QuizSubmissionService.java b/src/main/java/de/tum/cit/aet/artemis/quiz/service/QuizSubmissionService.java
index 1ee7e72ef21..beaf041f3a2 100644
--- a/src/main/java/de/tum/cit/aet/artemis/quiz/service/QuizSubmissionService.java
+++ b/src/main/java/de/tum/cit/aet/artemis/quiz/service/QuizSubmissionService.java
@@ -180,6 +180,8 @@ public class QuizSubmissionService extends AbstractQuizSubmissionService<QuizSub
      * @param quizExerciseId the id of the quiz exercise for which the results should be calculated
      */
     public void calculateAllResults(long quizExerciseId) {
+        // Thesis benchmark (decision D17): the duration of the evaluation that the scheduled task runs at the end of the quiz.
+        long thesisStartNanos = System.nanoTime();
         QuizExercise quizExercise = quizExerciseRepository.findByIdWithQuestionsAndCategoriesAndBatchesElseThrow(quizExerciseId);
         log.info("Calculating results for quiz {}", quizExercise.getId());
         Set<StudentParticipation> participations = studentParticipationRepository.findByExerciseId(quizExercise.getId());
@@ -227,6 +229,8 @@ public class QuizSubmissionService extends AbstractQuizSubmissionService<QuizSub
             sendQuizResultToUser(quizExerciseId, participation);
         });
         quizStatisticsService.notifyStatisticsChanged(quizExercise.getId());
+        log.info("Thesis benchmark: calculateAllResults quiz={} participations={} durationMillis={}", quizExerciseId, participations.size(),
+                (System.nanoTime() - thesisStartNanos) / 1_000_000);
     }
 
     /**
